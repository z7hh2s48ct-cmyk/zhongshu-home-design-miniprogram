<view class="v12-page budget-page" wx:if="{{accessReady}}">
  <v12-navbar title="旧版区间预算" show-back show-brand="{{false}}" />
  <view class="auto-note"><t-icon name="info-circle-filled" size="17px" color="#bf7d0e" /><text>旧版地区参考区间，不是新版分项报价</text></view>
  <view wx:if="{{loading || error}}" class="budget-card state-card"><v12-state status="{{loading ? 'loading' : 'error'}}" text="{{loading ? '正在导入项目参数…' : error}}" action-text="{{loading ? '' : '重试'}}" bind:action="load" card="{{false}}" /></view>
  <view class="v12-card budget-form">
    <view class="form-row"><text>建筑面积</text><view><input class="area-input" type="number" value="{{buildingArea}}" bindinput="onAreaInput" /> m²</view></view>
    <view class="form-row" bindtap="chooseStructure"><text>结构形式</text><text>{{structure.label}}</text><t-icon name="chevron-right" size="16px" color="#777" /></view>
    <view class="form-row standard-row"><text>建造标准</text><view><text wx:for="{{['经济','标准','品质']}}" wx:key="*this" class="{{standard === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectStandard">{{item}}</text></view></view>
  </view>
  <view class="v12-card explain"><text>此入口继续使用旧版VAR1参考区间规则，旧预算保持原始上下限，不拆为新分项。</text></view>
  <button class="v12-primary-button generate-budget" bindtap="generate" disabled="{{creating || loading || !!error || !projectId}}" loading="{{creating}}">生成旧版区间估算</button>
</view>
