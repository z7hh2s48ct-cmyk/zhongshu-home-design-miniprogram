<view class="v12-page">
  <v12-navbar title="我的" show-notice />
  <view class="v12-content v12-content--tab profile-content">
    <view class="v12-card user-card">
      <view class="identity"><image wx:if="{{authorized && avatar}}" src="{{avatar}}" mode="aspectFill" /><view wx:else class="guest-avatar"><t-icon name="user" size="30px" color="#9a6d39" /></view><text class="name">{{authorized ? (nickname || '筑梦人') : '访客'}}</text><text class="authorized">{{authorized ? '已激活' : '未激活'}}</text><view class="auth-link" bindtap="openAuthorization">{{authorized ? '授权信息' : '去激活'}} <t-icon name="chevron-right" size="15px" color="#2f2925" /></view></view>
      <view class="numbers"><view><text>{{authorized ? availablePoints : '—'}}</text><text>设计点</text></view><view><text>{{authorized ? projectCount : '—'}}</text><text>生成记录</text></view><view><text>{{authorized ? publishedCount : '—'}}</text><text>已发布</text></view></view>
    </view>
    <view class="points-card"><view class="coin"><t-icon name="money" size="27px" color="#d59a4a" /></view><view><text>设计点余额 <text class="points-value">{{authorized ? availablePoints : '—'}}</text></text><text>{{authorized ? '用于AI方案生成' : '激活后查看与使用'}}</text></view><view class="recharge" bindtap="openRecharge">立即充值</view></view>
    <view class="v12-card menu-card">
      <view bindtap="showPlaceholder"><t-icon name="file" size="24px" color="#626262" /><text>我的方案</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="showPlaceholder"><t-icon name="upload" size="24px" color="#626262" /><text>户型投稿</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="showPlaceholder"><t-icon name="star" size="24px" color="#626262" /><text>收藏户型</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
    </view>
    <view class="v12-card menu-card">
      <view bindtap="openRecharge"><t-icon name="money" size="24px" color="#626262" /><text>设计点充值</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="showPlaceholder"><t-icon name="file-add" size="24px" color="#626262" /><text>充值记录</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="openAuthorization"><t-icon name="secured" size="24px" color="#626262" /><text>授权信息</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="contact"><t-icon name="service" size="24px" color="#626262" /><text>联系客服</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
      <view bindtap="showPlaceholder"><t-icon name="setting" size="24px" color="#626262" /><text>设置</text><t-icon name="chevron-right" size="16px" color="#707070" /></view>
    </view>
  </view>
</view>
