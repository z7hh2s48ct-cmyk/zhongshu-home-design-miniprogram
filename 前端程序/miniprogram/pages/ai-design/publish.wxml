<view class="v12-page publish-page" wx:if="{{accessReady}}">
  <v12-navbar title="投稿到户型库" show-back show-brand="{{false}}" />
  <view class="v12-card publish-summary"><image wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFit" lazy-load /><view><text>AI设计方案投稿</text><text>{{versionReady ? '结果版本 v' + versionNumber : '结果版本读取中或不可用'}}</text><text>{{materialCount}} 项已选方案图片</text></view></view>
  <view class="v12-card audit-card"><view class="audit-title"><text>投稿参数校核</text><span>{{missing ? '尚未通过' : '已通过'}}</span></view>
    <view class="audit-row" wx:for="{{validation.missingFields}}" wx:key="*this"><text>{{item}}</text><span>需要补全</span></view>
    <view class="audit-row"><text>补充说明（选填）</text><span>{{note || '未填写'}}</span><button bindtap="completeDescription">编辑</button></view>
  </view>
  <view wx:if="{{validation && validation.message}}" class="review-note">{{validation.message}}</view>
  <view class="review-note">提交后进入后台审核，审核通过后仍需运营发布才会在户型库公开展示。</view>
  <view class="v12-card reference-switch"><text>同意公开展示本次方案</text><switch checked="{{allowPublicDisplay}}" color="#7b5532" bindchange="togglePublicDisplay" /></view>
  <view class="v12-card reference-switch"><text>允许作为生成参考（可选）</text><switch checked="{{allowReference}}" color="#7b5532" bindchange="toggleReference" /></view>
  <view class="{{missing || !versionReady || submitting ? 'v12-disabled-button' : 'v12-primary-button'}}" bindtap="submit">{{submitting ? '正在提交' : missing || !versionReady ? '请补全后提交' : '提交审核'}}</view>
</view>
