<view class="v12-page generating-page" wx:if="{{accessReady}}">
  <v12-navbar title="{{stage === 'plane' ? '平面方案生成' : '立面方案生成'}}" show-back show-brand="{{false}}" />
  <view class="v12-card hero-card">
    <view class="orb">
      <view wx:if="{{!finished}}" class="orb-ring"></view>
      <view class="orb-core {{finished ? 'done' : ''}}"><t-icon wx:if="{{finished}}" name="check" size="32px" /><text wx:else>AI</text></view>
    </view>
    <text class="hero-title">{{statusText}}</text>
    <text class="hero-sub">为您生成 {{count}} 个{{stage === 'plane' ? '平面' : '立面'}}方案 · {{finished ? '点选一个方案继续' : '预计 1~2 分钟'}}</text>
    <view class="job-spec"><text>{{resolution}}</text><i></i><text>{{orientation === 'PORTRAIT' ? '竖屏' : '横屏'}}</text><i></i><text>{{outputPixels}}</text></view>
    <view class="progress"><i class="shine" style="width: {{progress}}%;"></i></view>
    <view class="meter"><text class="percent">{{progress}}%</text><text class="elapsed">已用时 {{elapsedText}}</text></view>
  </view>

  <view class="v12-card step-card">
    <view class="flow">
      <view class="fstep {{stepIndex >= 0 ? 'on' : ''}}{{stepIndex > 0 ? 'done' : ''}}"><i>1</i><text>排队</text></view>
      <em class="line {{stepIndex >= 1 ? 'on' : ''}}"></em>
      <view class="fstep {{stepIndex >= 1 ? 'on' : ''}}{{stepIndex > 1 ? 'done' : ''}}"><i>2</i><text>生成</text></view>
      <em class="line {{stepIndex >= 2 ? 'on' : ''}}"></em>
      <view class="fstep {{stepIndex >= 2 ? 'on' : ''}}{{stepIndex > 2 ? 'done' : ''}}"><i>3</i><text>校验</text></view>
      <em class="line {{stepIndex >= 3 ? 'on' : ''}}"></em>
      <view class="fstep {{stepIndex >= 3 ? 'on' : ''}}"><i>4</i><text>完成</text></view>
    </view>
  </view>

  <view class="v12-card cand-card" wx:if="{{candidates.length || pendingSlots}}">
    <text class="sec-title">{{finished ? '选择' + (stage === 'plane' ? '平面' : '立面') + '方案' : '已生成候选（' + candidates.length + '/' + count + '）'}}</text>
    <text class="sec-sub">{{finished ? '点「选它」完成选择，选定后可继续下一步' : '每张方案一通过校验就会出现在这里，无需等待全部完成'}}</text>
    <view class="cand-grid">
      <view wx:for="{{candidates}}" wx:key="candidateId"
        class="cand {{selectedId === item.candidateId ? 'selected' : ''}}">
        <span class="slot">候选 {{item.slot}}</span>
        <image wx:if="{{item.url}}" class="cand-img" src="{{item.url}}" mode="aspectFill" lazy-load aria-label="{{item.name}}" binderror="candidateImageError" data-id="{{item.candidateId}}" />
        <view wx:else class="cand-img cand-loading" bindtap="retryCandidateImage" data-id="{{item.candidateId}}"><text>{{item.imageError || '校验通过，成图加载中'}}</text></view>
        <view class="pick {{selectedId === item.candidateId ? 'picked' : ''}}{{selecting ? ' busy' : ''}}"
          wx:if="{{finished}}" bindtap="selectCandidate" data-id="{{item.candidateId}}"
          aria-label="{{item.name}}，{{selectedId === item.candidateId ? '已选定' : '点选此方案'}}">
          <block wx:if="{{selectedId === item.candidateId}}"><t-icon name="check" size="16px" /> 已选定</block>
          <block wx:elif="{{selecting}}">提交中…</block>
          <block wx:else>选它</block>
        </view>
        <view wx:else class="pick passed">已通过</view>
      </view>
      <view wx:for="{{pendingSlots}}" wx:key="*this" wx:for-index="pi" class="cand pending">
        <span class="slot">候选 {{candidates.length + pi + 1}}</span>
        <view class="cand-img cand-loading"><text>AI 绘制中…</text></view>
      </view>
    </view>
  </view>

  <view class="v12-card cand-card" wx:elif="{{finished && !candidates.length}}">
    <text class="sec-title">{{candidatesError ? '候选加载失败' : '本次未生成可用方案'}}</text>
    <text class="sec-sub">{{candidatesError ? '网络波动导致候选读取失败，生成结果不受影响，可重试加载。' : '生成结果未全部通过校验，点数已按有效方案结算，多付点数将自动退回。'}}</text>
    <view class="empty-actions">
      <view wx:if="{{candidatesError}}" class="v12-primary-button" bindtap="retryCandidates">重试加载</view>
      <view wx:else class="v12-primary-button" bindtap="regenerate">{{regenerating ? '重新生成中…' : '重新生成'}}</view>
      <view class="v12-secondary-button" bindtap="leavePage">返回上一步</view>
    </view>
  </view>

  <view class="stage-tip"><t-icon name="info-circle" size="24px" color="#b9690b" /><text>生成失败或数量不足时按有效方案结算，退点自动到账</text></view>

  <view wx:if="{{finished && !selectDone && candidates.length}}" class="regen-row" bindtap="regenerate" role="button" aria-label="重新生成候选方案">
    <t-icon name="refresh" size="16px" color="#7b5532" />
    <text>{{regenerating ? '正在创建生成任务…' : '对方案不满意？重新生成（将确认点数）'}}</text>
  </view>

  <view class="actions" wx:if="{{!finished}}"><view class="v12-primary-button" bindtap="continueLater">后台继续</view><view wx:if="{{canCancel}}" class="v12-secondary-button" bindtap="cancel">{{cancelling ? '取消处理中' : '取消生成'}}</view></view>
  <view wx:if="{{selectDone}}" class="btn-next" bindtap="nextStep">{{nextLabel}}</view>
  <view wx:if="{{pollError}}" class="poll-error">{{pollError}}</view>
</view>
