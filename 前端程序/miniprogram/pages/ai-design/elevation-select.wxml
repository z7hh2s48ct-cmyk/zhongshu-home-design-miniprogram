<view class="v12-page elevation-select-page" wx:if="{{accessReady}}">
  <v12-navbar title="选择立面方案" show-back show-brand="{{false}}" />
  <view class="steps"><view>步骤1 ✓</view><text>平面方案</text><i></i><view class="active">步骤2</view><text>立面方案</text></view>
  <text class="select-title">请选择一个立面方案</text><text class="select-subtitle">已生成{{elevations.length}}个立面方向，平面方案已锁定</text>
  <view wx:if="{{loading}}" class="select-empty">立面候选加载中…</view>
  <view class="main-elevation {{selected === index ? 'selected' : ''}}" wx:for="{{elevations}}" wx:key="id" data-index="{{index}}" bindtap="select"><view class="elevation-name">{{item.name}}<text wx:if="{{index === 0}}"> 比例协调 · 推荐</text></view><view class="check" wx:if="{{selected === index}}">✓</view><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /><text wx:else class="plan-placeholder">效果图加载中</text></view>
  <view class="v12-card locked-summary"><view class="house-icon"><t-icon name="home-filled" size="28px" color="#7b3f17" /></view><view><text>已选平面：{{flatLabel || '平面方案已锁定'}}</text><text>立面方案将严格继承已选平面方案的空间关系与尺寸</text></view><view class="lock-line"><t-icon name="lock-on" size="15px" color="#777" /> 平面方案已锁定，立面将严格匹配空间关系</view></view>
  <text class="consume">重新生成前将确认最新点数</text>
  <view class="actions"><view class="v12-secondary-button" bindtap="regenerate">重新生成</view><view class="v12-primary-button" bindtap="confirm">完成方案</view></view>
</view>
