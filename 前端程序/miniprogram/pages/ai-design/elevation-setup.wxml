<view class="v12-page setup-page" wx:if="{{accessReady}}">
  <v12-navbar title="立面方案设置" show-back show-brand="{{false}}" />
  <view class="steps"><view>步骤1 ✓</view><text>平面方案</text><i></i><view class="active">步骤2</view><text>立面方案</text></view>
  <view class="v12-card selected-plan"><text>{{flatLabel}}</text><view><image src="{{flatImageUrl || '/assets/v12/plan-b-1.png'}}" mode="aspectFit" /><image wx:if="{{!flatImageUrl}}" src="/assets/v12/plan-b-2.png" mode="aspectFit" /><view><text>平面已锁定</text><span>查看 〉</span></view></view></view>
  <view class="v12-card option-card"><text>建筑风格</text><view><text wx:for="{{styleOptions}}" wx:key="code" class="{{style === item.code ? 'selected' : ''}}" data-field="style" data-value="{{item.code}}" bindtap="choose">{{item.label}}<i wx:if="{{style === item.code}}">✓</i></text></view></view>
  <view class="v12-card option-card"><text>屋顶形式</text><view><text wx:for="{{roofOptions}}" wx:key="code" class="{{roof === item.code ? 'selected' : ''}}" data-field="roof" data-value="{{item.code}}" bindtap="choose">{{item.label}}<i wx:if="{{roof === item.code}}">✓</i></text></view></view>
  <view class="v12-card option-card"><text>外墙材质</text><view><text wx:for="{{wallOptions}}" wx:key="code" class="{{wall === item.code ? 'selected' : ''}}" data-field="wall" data-value="{{item.code}}" bindtap="choose">{{item.label}}<i wx:if="{{wall === item.code}}">✓</i></text></view></view>
  <view class="v12-card option-card"><text>点缀色</text><view><text wx:for="{{accentOptions}}" wx:key="code" class="{{accent === item.code ? 'selected' : ''}}" data-field="accent" data-value="{{item.code}}" bindtap="choose">{{item.label}}<i wx:if="{{accent === item.code}}">✓</i></text></view></view>
  <view class="v12-card option-card count-card"><text>生成数量</text><view><text wx:for="{{[1,2,4]}}" wx:key="*this" class="{{count === item ? 'selected' : ''}}" data-count="{{item}}" bindtap="selectCount">{{item}}个</text></view></view>
  <view class="v12-card point-cost"><view><text>当前余额</text><b>{{points}} <span>设计点</span></b></view><i></i><view><text>单个6设计点 × {{count}} =</text><b>预计 {{count * 6}} <span>设计点</span></b></view></view>
  <view class="v12-primary-button" bindtap="generate">生成立面方案</view>
</view>
