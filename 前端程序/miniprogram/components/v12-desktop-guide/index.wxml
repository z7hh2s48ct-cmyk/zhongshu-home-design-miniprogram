<view class="dt-guide" wx:if="{{!closed}}">
  <view class="dt-guide-bar" role="button" aria-label="查看添加到{{platform === 'ios' ? '我的小程序' : '桌面'}}的方法" bindtap="showSteps">
    <view class="dt-guide-icon"><t-icon name="add-circle" size="22px" color="#b86600" /></view>
    <view class="dt-guide-copy">
      <text class="dt-guide-title">{{platform === 'ios' ? '把「众墅之家」加入我的小程序' : '把「众墅之家」添加到手机桌面'}}</text>
      <text class="dt-guide-sub">下次打开更快，方案与预算随手可查</text>
    </view>
    <view class="dt-guide-action" catchtap="showSteps" role="button" aria-label="查看方法">方法</view>
    <view class="dt-guide-close" catchtap="dismiss" role="button" aria-label="不再提示"><t-icon name="close" size="15px" color="#9a938c" /></view>
  </view>

  <view class="dt-mask" wx:if="{{expanded}}" bindtap="closeSheet">
    <view class="dt-sheet" catchtap="keepSheet">
      <view class="dt-sheet-head">
        <text class="dt-sheet-title">{{platform === 'ios' ? '添加到「我的小程序」' : '添加到手机桌面'}}</text>
        <view class="dt-sheet-close" bindtap="closeSheet" role="button" aria-label="关闭说明"><t-icon name="close" size="22px" color="#777a82" /></view>
      </view>
      <text class="dt-note">{{platform === 'ios' ? 'iOS 系统不允许小程序直接放到桌面，「我的小程序」是等效的快捷入口。' : '部分微信版本也可在小程序内点右上角「···」菜单直接添加。'}}</text>
      <view class="dt-steps">
        <view class="dt-step" wx:for="{{steps}}" wx:key="title">
          <text class="dt-step-no">{{index + 1}}</text>
          <view class="dt-step-copy">
            <text class="dt-step-title">{{item.title}}</text>
            <text class="dt-step-detail">{{item.detail}}</text>
          </view>
        </view>
      </view>
      <view class="dt-sheet-actions">
        <button class="dt-btn-primary" bindtap="closeSheet">我知道了</button>
        <button class="dt-btn-plain" bindtap="dismiss">不再提示</button>
      </view>
    </view>
  </view>
</view>
