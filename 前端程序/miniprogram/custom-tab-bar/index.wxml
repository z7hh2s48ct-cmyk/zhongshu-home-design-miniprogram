<view class="tabbar-shell">
  <view class="tabbar">
    <view class="tabbar-item {{current === index ? 'tabbar-item--active' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" bindtap="switchTab" data-index="{{index}}">
      <view class="tabbar-icon">
        <t-icon name="{{current === index ? item.activeIcon : item.icon}}" size="24px" />
        <view wx:if="{{item.pagePath === '/pages/profile/index' && unreadCount > 0}}" class="tabbar-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <text class="tabbar-label">{{item.text}}</text>
    </view>
  </view>
</view>
