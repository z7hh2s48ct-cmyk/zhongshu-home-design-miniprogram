<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yudao-module-commerce</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        commerce 模块（对应架构文档 zhongshu-module-commerce）：
        计价快照、设计点账户与只追加账本、充值方案、充值订单、权益到账与对账。
        领域包：pricing / points / recharge / payment。
    </description>

    <dependencies>
        <!-- 众墅 Infra 扩展端口（ReliableEventPort/AuditPort/DeliveryPort）；业务模块允许依赖 infra，禁止依赖其他业务模块 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 限流（T13-25 微信支付通知入口 @RateLimiter）：与 identity 模块一致，独立限流不复用业务端点配额 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-protection</artifactId>
        </dependency>

        <!-- Web 安全（传递引入 web starter，提供 CommonResult/异常/接口文档） -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- B4 微信支付（T13-21）：复用底座 yudao-dependencies 已锁定的 weixin-java-pay（WxJava 生态，支持 v3 API）。
             provider=stub 时仅装配 StubPaymentPortAdapter，本依赖的类不会被加载；provider=real 时由 WechatPaymentAdapter 消费。
             本期不新增官方 wechatpay-java SDK，与 yudao 底座 SocialClientServiceImpl 保持技术栈一致（分派表 §1 SDK 选择决策）。 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-pay</artifactId>
        </dependency>

        <!-- Web 校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- P4A 合同测试：真实 PostgreSQL（Testcontainers + Flyway） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
