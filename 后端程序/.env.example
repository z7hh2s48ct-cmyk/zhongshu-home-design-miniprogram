# 仅供本机开发。复制为 .env 后可按需修改；不要写入真实生产凭据。
ZS_PG_DATABASE=zhongshu_design
ZS_PG_USERNAME=zhongshu
ZS_PG_PASSWORD=zhongshu
ZS_PG_PORT=5432
ZS_PG_URL=jdbc:postgresql://127.0.0.1:5432/zhongshu_design
ZS_REDIS_HOST=127.0.0.1
ZS_REDIS_PORT=6379
# 微信小程序身份（identity 模块 code2session）。ZS_WX_APPID 为公开标识、非机密，与前端发布工程 project.config.json 保持一致（映射 zhongshu.identity.wechat-appid）；
# ZS_WX_APPSECRET 是真正的机密，切勿写入本文件或提交仓库——切 provider=real 前由部署环境带外注入（映射 wechat-appsecret），留空时启动守卫拒绝 real 模式。
ZS_WX_APPID=wx5753299f05a5c138
ZS_WX_APPSECRET=
# 腾讯云 COS 私有桶（design 模块对象存储，映射 zhongshu.design.asset.storage.cos.*，切 provider=cos 时由 CosObjectStorageAdapter 消费）。
# endpoint/region/bucket 为非机密部署配置（endpoint 形如 https://cos.<region>.myqcloud.com）；
# ZS_COS_SECRET_ID/ZS_COS_SECRET_KEY 是真正的机密，切勿写入本文件或提交仓库——切 provider=cos 前由部署环境带外注入，留空时启动守卫拒绝 cos 模式。
# ZS_COS_PATH_STYLE_ACCESS：腾讯 COS 用虚拟主机式（false）；MinIO 兼容端联调用 true。
ZS_COS_ENDPOINT=
ZS_COS_REGION=
ZS_COS_BUCKET=
ZS_COS_SECRET_ID=
ZS_COS_SECRET_KEY=
ZS_COS_PATH_STYLE_ACCESS=false
ZS_COS_API_CALL_TIMEOUT_MS=20000
